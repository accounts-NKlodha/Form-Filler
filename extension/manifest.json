{
  "manifest_version": 3,
  "name": "MCA form filler (MVP)",
  "version": "0.7.1",
  "description": "Fills MCA V3 web forms from the firm's Excel via a local server. Side panel: Save form (Alt+Shift+D) and Form Filler (Alt+Shift+F). Never submits.",
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel"],
  "host_permissions": ["http://127.0.0.1:8742/*", "https://www.mca.gov.in/*"],
  "action": { "default_title": "Open the MCA filler side panel" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://www.mca.gov.in/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.mca.gov.in/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
